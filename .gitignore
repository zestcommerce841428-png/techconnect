config.php
.env

# Database dumps must never be committed (schema.sql and migrations/ are the
# tracked source of truth; anything else is a data export with real user data)
*.sql
!schema.sql
!migrations/*.sql
node_modules/
*.log
uploads/*
!uploads/.htaccess
backups/

# NOTE: assets/css/tailwind.min.css and assets/dist/ (minified JS) are
# intentionally tracked, not ignored — Hostinger shared hosting has no
# npm/build step, so compiled assets must be committed and deployed as-is.
# Run `npm run build` locally before every FTP deploy.
